{
  "manifest_version": 3,
  "name": "Paseo Browser Companion",
  "version": "0.1.0",
  "minimum_chrome_version": "120",
  "description": "Route Paseo notifications to their agent's existing tab.",
  "permissions": ["notifications", "storage", "tabs"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["http://127.0.0.1/*"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "action": { "default_popup": "popup.html", "default_title": "Paseo Browser Companion" },
  "icons": { "128": "notification-icon.png" }
}
